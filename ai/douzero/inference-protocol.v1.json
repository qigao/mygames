{
  "schema": "mygames.douzero.inference/1",
  "status": "draft-unqualified",
  "method": "douzero.q.evaluate",
  "objective": "wp",
  "transports": [
    "http2-jsonrpc-2.0",
    "websocket"
  ],
  "required_request": [
    "protocol_version",
    "ticket_id",
    "request_id",
    "request_id_base",
    "game_id",
    "room_generation",
    "owner_epoch",
    "transport_generation",
    "turn_id",
    "seat",
    "landlord_seat",
    "role",
    "model_version",
    "model_sha256",
    "rules_profile",
    "objective",
    "legal_list_sha256",
    "legal_action_count",
    "chunk_index",
    "chunk_count",
    "x",
    "z",
    "actions",
    "deadline_ms"
  ],
  "required_response": [
    "protocol_version",
    "ticket_id",
    "request_id",
    "request_id_base",
    "game_id",
    "room_generation",
    "owner_epoch",
    "transport_generation",
    "turn_id",
    "seat",
    "landlord_seat",
    "role",
    "model_version",
    "model_sha256",
    "rules_profile",
    "objective",
    "legal_list_sha256",
    "legal_action_count",
    "chunk_index",
    "chunk_count",
    "scores"
  ],
  "limits": {
    "x_landlord": 319,
    "x_farmer": 430,
    "history": 810,
    "action_width": 54,
    "max_actions_per_chunk": 64,
    "min_actions_per_chunk": 1,
    "max_pending_per_turn": 1,
    "max_full_legal_actions": 16384,
    "max_chunks_per_ticket": 256,
    "max_request_body_bytes": 32768
  },
  "statuses": [
    "ok",
    "invalid_request",
    "stale_turn",
    "stale_model",
    "deadline",
    "cancelled",
    "over_capacity",
    "model_unavailable",
    "nonfinite_q",
    "transport_failure"
  ],
  "source": {
    "douzero_upstream_commit": "718a5c920bf3361e34178a38f3b80458e176b351",
    "kfcore_original_profile": "douzero.original.wp",
    "legacy_profile_not_accepted": "ddz-dmc-replay-v1"
  },
  "rules": {
    "owner_authoritative": true,
    "service_may_commit": false,
    "automatic_fallback": false,
    "actor_private_hands_only": true,
    "legacy_model_profile_forbidden": true,
    "remote_reply_never_is_game_ack": true,
    "never_auto_pass_on_timeout": true,
    "owner_must_revalidate_move_at_commit": true
  },
  "json_encoding": {
    "u64_fields": "canonical unsigned decimal strings, never JSON floating-point numbers",
    "uint32_fields": "JSON nonnegative integers",
    "model_sha256": "64 lowercase hexadecimal characters; exact authenticated ONNX artifact bytes",
    "legal_list_sha256": "64 lowercase hexadecimal characters",
    "x_z_actions": "arrays of only integer 0 or 1, ordered exactly as original DouZero actor features",
    "scores": "finite numeric array, exactly the requested chunk length",
    "request_id": "one distinct active JSON-RPC or WS wire ID per 64-action chunk",
    "request_id_base": "wire ID for first chunk; expected request_id = base + chunk_index",
    "ticket_id": "immutable owner-generated logical ticket identifier for whole legal list",
    "deadline_ms": "relative request bound; owner separately stores monotonic absolute deadline"
  },
  "legal_list_digest": {
    "algorithm": "SHA-256",
    "domain": "mygames.douzero.legal.v1\\0 (literal ASCII bytes with one NUL terminator)",
    "body": "uint32_le(full_action_count) || uint64_le(each canonical original ordered 54-bit physical action mask including zero for PASS)",
    "owner_computed": true,
    "service_echo_only": true
  },
  "staged_contract": {
    "owner_ticket_c11_implemented": true,
    "live_chttp_h2_transport_implemented": false,
    "live_ws_transport_implemented": false,
    "cpp_service_implemented": false,
    "production_game_owner_commit_hook_implemented": false,
    "full_original_legal_actions_qualified": false
  }
}
